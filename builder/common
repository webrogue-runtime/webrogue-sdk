set -ex

docker --version | grep podman >/dev/null || {
    DOCKER_USER_FLAGS="-u $(id -u ${USER}):$(id -g ${USER})"
}
SDK_DIR=$(dirname $(pwd))
WEBROGUE_REPO_DIR=${WEBROGUE_REPO_ROOT:-$(git -C "$SDK_DIR" rev-parse --show-superproject-working-tree 2>/dev/null || true)}

builder_image_name=webrogue_sdk_builder
DOCKER_PLATFORM_FLAGS="--platform linux/amd64"
docker build $DOCKER_PLATFORM_FLAGS -t $builder_image_name . 
run_in_builder_docker() {
    docker run \
        --rm \
        -v $SDK_DIR/libraries:/sdk_dir/libraries \
        -v $SDK_DIR/cargo/src:/fakehome/.cargo/registry/src \
        -v $SDK_DIR/cargo/cache:/fakehome/.cargo/registry/cache \
        -v $SDK_DIR/cargo/index:/fakehome/.cargo/registry/index \
        -v $SDK_DIR/opt:/sdk_dir/opt \
        -v $SDK_DIR/meson:/sdk_dir/meson \
        -v $SDK_DIR/package:/sdk_dir/package \
        $DOCKER_USER_FLAGS \
        $DOCKER_PLATFORM_FLAGS \
        -t $builder_image_name \
        bash -c "$1"
}


examples_builder_image_name=webrogue_sdk_examples_builder
run_in_examples_builder_docker() {
    command_to_run=$1
    set -- \
        -v "$(pwd):/sdk_dir/examples" \
        -v "$SDK_DIR/libraries:/sdk_dir/libraries"
    if test -n "$WEBROGUE_REPO_DIR" && test -d "$WEBROGUE_REPO_DIR/tests"; then
        set -- "$@" -v "$WEBROGUE_REPO_DIR/tests:/sdk_dir/tests"
    fi
    docker run \
        --rm \
        "$@" \
        $DOCKER_USER_FLAGS \
        $DOCKER_PLATFORM_FLAGS \
        -t $examples_builder_image_name \
        bash -c "$command_to_run"
}

